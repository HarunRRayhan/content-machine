APP_NAME="Content Machine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Port the container listens on (matches the base image's nginx default; Railway).
PORT=8080
# TLS is terminated at Railway's edge, so the app itself serves plain HTTP.
SSL_MODE=off
# Must stay false in production: the serversideup/php image's automation would
# otherwise run migrations on every container boot. The web pre-deploy command
# runs migrations explicitly before the worker processes application queues.
AUTORUN_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Closes public sign-up (GET and POST /register both return 403) so a single
# operator can self-host without opening account creation to the internet.
# Create your own account first — set ADMIN_EMAIL below and deploy, or
# you'll lock yourself out with no way back in.
DISABLE_REGISTRATION=false

# Optional. When set, `php artisan cm:ensure-admin` (wired into
# railway.web.json's preDeployCommand) creates this user with a personal
# team if it doesn't already exist yet, and prints a one-time generated
# password to the deploy log. Idempotent — safe to leave set permanently.
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Admin

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Railway captures stdout/stderr directly; stderr avoids writing to a log file
# that never gets flushed to persistent storage.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=content_machine
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# PostSyncer post publishes use the dedicated cm-web worker. Keep this above
# PublishPostJob's 900-second timeout or the database can redeliver it early.
# POSTSYNCER_QUEUE_RETRY_AFTER=960

# Production-only cutover gate for generation-scoped Telegram uniqueness.
# Set true only after the old web fleet is drained and all legacy Telegram
# outbound rows have been reconciled; unset/false blocks those migrations.
# CM_TELEGRAM_CUTOVER_READY=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
