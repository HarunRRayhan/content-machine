{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/Dockerfile",
    "watchPatterns": [
      "app/**",
      "routes/**",
      "resources/**",
      "public/**",
      "config/**",
      "database/**",
      "bootstrap/**",
      "composer.*",
      "package*.json",
      "deploy/**"
    ]
  },
  "deploy": {
    "startCommand": "docker-php-serversideup-entrypoint /init",
    "preDeployCommand": ["php artisan cm:deploy"],
    "healthcheckPath": "/up",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 30,
    "drainingSeconds": 960
  }
}
