# syntax=docker/dockerfile:1

############################################
# Stage: vendor — PHP dependencies
############################################
FROM composer:2.8 AS vendor
WORKDIR /app
COPY . .
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-scripts \
    --optimize-autoloader

############################################
# Stage: assets — frontend build
############################################
# resources/js/{routes,actions} are gitignored and generated by
# `php artisan wayfinder:generate --with-form`, which needs a bootable Laravel
# app (vendor installed, APP_KEY set). This mirrors ci.yml's `frontend` job:
# PHP setup -> composer install -> copy .env -> key:generate ->
# wayfinder:generate --with-form -> npm ci -> build.
FROM node:26-trixie-slim AS assets
WORKDIR /app

# Debian trixie ships PHP 8.4 in its default repos, so no extra APT source is
# needed. This PHP install only exists to run two artisan commands below; it
# never ships in the final image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        php8.4-cli \
        php8.4-bcmath \
        php8.4-curl \
        php8.4-gd \
        php8.4-intl \
        php8.4-mbstring \
        php8.4-pgsql \
        php8.4-xml \
        php8.4-zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=vendor /app/vendor ./vendor
COPY . .

# Throwaway .env: only needs an APP_KEY so artisan can boot. Discarded with
# this build stage; Railway supplies the real environment at runtime.
RUN cp .env.example .env \
    && php artisan key:generate --force \
    && php artisan wayfinder:generate --with-form

RUN npm ci
RUN npm run build

############################################
# Stage: app — runtime image
############################################
FROM serversideup/php:8.4-fpm-nginx-v4.5.1 AS app

WORKDIR /var/www/html

# Stay root through the rest of the image. The serversideup entrypoint
# drops nginx/php-fpm to www-data; we need root at start so
# deploy/docker/entrypoint.d/20-writable-uploads.sh can chown the Railway
# volume mounted at storage/app/uploads (fresh volumes are root:root, and
# www-data cannot mkdir workspace folders on them).
USER root

# yt-dlp is pinned by release tag + sha256 of the published checksum file
# (github.com/yt-dlp/yt-dlp/releases/download/<tag>/SHA2-256SUMS), verified
# below rather than trusted blindly off the network.
ARG YTDLP_VERSION=2026.07.04
ARG YTDLP_SHA256=6bbb3d314cde4febe36e5fa1d55462e29c974f63444e707871834f6d8cc210ae

# ffmpeg + yt-dlp: not used yet, baked in now for the Telegram bot's media
# pipeline (a later phase) so this Dockerfile doesn't need revisiting then.
# supervisor: runs the worker service's queue/schedule processes (see
# deploy/docker/supervisord.conf); the web service doesn't use it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /tmp/yt-dlp "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp_linux" \
    && echo "${YTDLP_SHA256}  /tmp/yt-dlp" | sha256sum -c - \
    && install -m 0755 /tmp/yt-dlp /usr/local/bin/yt-dlp \
    && rm /tmp/yt-dlp

COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build
# resources/js/{routes,actions} are only consumed by the Vite build above
# (already baked into public/build); nothing server-side reads the raw
# TS source at runtime, so it isn't copied into this stage.
COPY . .

COPY deploy/docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY --chmod=755 deploy/docker/entrypoint.d/ /etc/entrypoint.d/

RUN mkdir -p storage/app/uploads \
    && chown -R www-data:www-data storage bootstrap/cache

# Port 8080 is already exposed by the base image. Do not USER www-data
# here: the entrypoint must start as root to chown the uploads volume.
