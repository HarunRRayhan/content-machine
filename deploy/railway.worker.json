{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/Dockerfile",
    "watchPatterns": [
      "app/**",
      "routes/**",
      "resources/**",
      "public/**",
      "config/**",
      "database/**",
      "bootstrap/**",
      "composer.*",
      "package*.json",
      "deploy/**"
    ]
  },
  "deploy": {
    "startCommand": "/usr/local/bin/cm-start-worker",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 120
  }
}
